{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/games",
      "destination": "/api/index.js"
    },
    {
      "source": "/roms/(.*)",
      "destination": "/public/roms/$1"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}